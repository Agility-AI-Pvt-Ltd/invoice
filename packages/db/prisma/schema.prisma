generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Users & Organizations (Multi-tenant Foundation)
// ------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String?
  name          String?
  image         String?
  isOnboarded   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  organizations Organization[] @relation("OrganizationUsers")
  ownedOrgs     Organization[] @relation("OrganizationOwner")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logo         String?
  address      String?
  currency     String   @default("INR")
  gstin        String?
  stateCode    String?
  phone        String?
  website      String?
  bankName     String?
  bankAccount  String?
  bankIfsc     String?
  
  ownerId      String
  owner        User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  users        User[]   @relation("OrganizationUsers")

  defaultTemplate  String   @default("modern")
  invoicePrefix    String   @default("INV")
  defaultDueDays   Int      @default(30)
  whatsappNumber   String?

  inventoryTrackingEnabled Boolean @default(false)

  customers         Customer[]
  productCategories ProductCategory[]
  products          Product[]
  warehouses        Warehouse[]
  inventoryMovements InventoryMovement[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  paymentGateways   PaymentGatewayConfig[]
  emailConfig       EmailConfig?
  whatsAppConfig    WhatsAppConfig?
  activityLogs      ActivityLog[]
  contacts          Contact[]
  deals             Deal[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ProductKind {
  GOOD
  SERVICE
}

model ProductCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String?
  parentId    String?
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, parentId])
}

// ------------------------------------------------------
// Core Business Entities
// ------------------------------------------------------

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  email          String?
  phone          String?
  address        String?
  gstin          String?
  stateCode      String?
  isRegistered   Boolean      @default(false)
  
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  contacts          Contact[]
  deals             Deal[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sku            String?
  name           String
  description    String?
  productKind    ProductKind  @default(GOOD)
  price          Float
  hsnCode        String?
  taxRate        Float        @default(18)
  unit           String?

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Public or signed URLs; prefer gs://bucket/object keys — see lib/storage for GCP
  imageUrls Json?

  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]
  invoiceItems   InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, name])
  @@index([organizationId, categoryId])
  @@unique([organizationId, sku])
}

// ------------------------------------------------------
// Inventory (warehouse + stock movements)
// ------------------------------------------------------

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  code      String?
  isDefault Boolean  @default(false)

  inventoryItems   InventoryItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isDefault])
}

model InventoryItem {
  id          String @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityOnHand Decimal  @db.Decimal(14, 4)
  reorderPoint   Decimal? @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

enum InventoryMovementType {
  SALE
  SALE_REVERSAL
  ADJUSTMENT
  INITIAL
}

model InventoryMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  type      InventoryMovementType
  quantity  Decimal  @db.Decimal(14, 4)

  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceItemId String?
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  /// Idempotent key, e.g. sale-paid:{invoiceId}:{invoiceItemId}
  idempotencyKey String @unique

  note String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([invoiceId])
  @@index([productId])
}

// ------------------------------------------------------
// Invoicing
// ------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  invoiceNumber  String
  issueDate      DateTime     @default(now())
  dueDate        DateTime
  placeOfSupply  String?

  status         InvoiceStatus @default(DRAFT)

  subTotal       Decimal       @db.Decimal(12, 2)
  cgstTotal      Decimal       @default(0) @db.Decimal(12, 2)
  sgstTotal      Decimal       @default(0) @db.Decimal(12, 2)
  igstTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)

  notes          String?

  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)

  items          InvoiceItem[]
  payments       Payment[]
  paymentLinks   PaymentLink[]
  inventoryMovements InventoryMovement[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([customerId])
  @@index([recurringInvoiceId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description String
  hsnCode     String?
  quantity    Float
  unitPrice   Float
  unit        String?

  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  inventoryMovements InventoryMovement[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now())
  method      String?
  notes       String?
  gatewayProvider  String?
  gatewayPaymentId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

// ------------------------------------------------------
// Payment Gateways
// ------------------------------------------------------

enum PaymentProvider {
  RAZORPAY
  PAYTM
  STRIPE
  CASHFREE
}

enum PaymentLinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model PaymentGatewayConfig {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       PaymentProvider
  keyId          String
  keySecret      String
  webhookSecret  String?
  isActive       Boolean         @default(true)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, provider])
}

model PaymentLink {
  id             String            @id @default(cuid())
  invoiceId      String
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  provider       PaymentProvider
  externalId     String
  shortUrl       String
  upiQrData      String?
  status         PaymentLinkStatus @default(PENDING)
  
  expiresAt      DateTime?
  paidAt         DateTime?
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([externalId])
  @@index([invoiceId])
}

// ------------------------------------------------------
// Email Configuration
// ------------------------------------------------------

enum EmailProvider {
  RESEND
  SMTP
  SENDGRID
}

model EmailConfig {
  id             String        @id @default(cuid())
  organizationId String        @unique
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       EmailProvider @default(RESEND)
  apiKey         String?
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  fromName       String        @default("Billing")
  fromEmail      String        @default("billing@example.com")
  isVerified     Boolean       @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ------------------------------------------------------
// WhatsApp Configuration
// ------------------------------------------------------

enum WhatsAppProvider {
  TWILIO
  WATI
  META_CLOUD
}

model WhatsAppConfig {
  id             String           @id @default(cuid())
  organizationId String           @unique
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       WhatsAppProvider @default(TWILIO)
  apiKey         String
  apiSecret      String?
  phoneNumberId  String?
  businessNumber String
  isActive       Boolean          @default(true)
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

// ------------------------------------------------------
// Audit Log
// ------------------------------------------------------

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  userId         String?
  entity         String
  entityId       String
  action         String
  meta           Json?
  
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityId])
}

// ------------------------------------------------------
// Recurring Invoices
// ------------------------------------------------------

enum RecurringInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model RecurringInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  title          String?
  interval       RecurringInterval
  nextIssueDate  DateTime
  endDate        DateTime?
  active         Boolean      @default(true)

  dueDays        Int          @default(30)
  autoSend       Boolean      @default(false)

  subTotal       Decimal      @db.Decimal(12, 2)
  cgstTotal      Decimal      @default(0) @db.Decimal(12, 2)
  sgstTotal      Decimal      @default(0) @db.Decimal(12, 2)
  igstTotal      Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)

  notes          String?
  items          RecurringInvoiceItem[]
  generatedInvoices Invoice[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active, nextIssueDate])
}

model RecurringInvoiceItem {
  id                 String           @id @default(cuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  
  description String
  hsnCode     String?
  quantity    Float
  unitPrice   Float
  unit        String?
  
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  sgstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  igstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// CRM Foundation (Future Module — DB-ready now)
// ------------------------------------------------------

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  name           String
  email          String?
  phone          String?
  role           String?
  notes          String?
  lastContactedAt DateTime?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  title          String
  value          Float?
  currency       String       @default("INR")
  stage          String       @default("Lead")
  expectedCloseAt DateTime?
  closedAt       DateTime?
  notes          String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, stage])
}