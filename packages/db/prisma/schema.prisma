generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Users & Organizations (Multi-tenant Foundation)
// ------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String?
  name          String?
  image         String?
  isOnboarded   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  organizations Organization[] @relation("OrganizationUsers")
  ownedOrgs     Organization[] @relation("OrganizationOwner")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logo         String?
  address      String?
  currency     String   @default("INR")
  gstin        String?
  stateCode    String?
  phone        String?
  website      String?
  bankName     String?
  bankAccount  String?
  bankIfsc     String?
  
  ownerId      String
  owner        User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  users        User[]   @relation("OrganizationUsers")

  defaultTemplate  String   @default("modern")
  invoicePrefix    String   @default("INV")
  defaultDueDays   Int      @default(30)
  whatsappNumber   String?

  customers         Customer[]
  products          Product[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  paymentGateways   PaymentGatewayConfig[]
  emailConfig       EmailConfig?
  whatsAppConfig    WhatsAppConfig?
  activityLogs      ActivityLog[]
  contacts          Contact[]
  deals             Deal[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------
// Core Business Entities
// ------------------------------------------------------

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  email          String?
  phone          String?
  address        String?
  gstin          String?
  stateCode      String?
  isRegistered   Boolean      @default(false)
  
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  contacts          Contact[]
  deals             Deal[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  description    String?
  price          Float
  hsnCode        String?
  taxRate        Float        @default(18)
  unit           String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

// ------------------------------------------------------
// Invoicing
// ------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  invoiceNumber  String
  issueDate      DateTime     @default(now())
  dueDate        DateTime
  placeOfSupply  String?
  
  status         InvoiceStatus @default(DRAFT)
  
  subTotal       Float
  cgstTotal      Float         @default(0)
  sgstTotal      Float         @default(0)
  igstTotal      Float         @default(0)
  total          Float
  
  notes          String?
  
  items          InvoiceItem[]
  payments       Payment[]
  paymentLinks   PaymentLink[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([customerId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  description String
  hsnCode     String?
  quantity    Float
  unitPrice   Float
  unit        String?
  
  taxRate     Float    @default(0)
  cgstAmount  Float    @default(0)
  sgstAmount  Float    @default(0)
  igstAmount  Float    @default(0)
  total       Float
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  amount      Float
  paymentDate DateTime @default(now())
  method      String?
  notes       String?
  gatewayProvider  String?
  gatewayPaymentId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

// ------------------------------------------------------
// Payment Gateways
// ------------------------------------------------------

enum PaymentProvider {
  RAZORPAY
  PAYTM
  STRIPE
  CASHFREE
}

enum PaymentLinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model PaymentGatewayConfig {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       PaymentProvider
  keyId          String
  keySecret      String
  webhookSecret  String?
  isActive       Boolean         @default(true)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, provider])
}

model PaymentLink {
  id             String            @id @default(cuid())
  invoiceId      String
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  provider       PaymentProvider
  externalId     String
  shortUrl       String
  upiQrData      String?
  status         PaymentLinkStatus @default(PENDING)
  
  expiresAt      DateTime?
  paidAt         DateTime?
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([externalId])
  @@index([invoiceId])
}

// ------------------------------------------------------
// Email Configuration
// ------------------------------------------------------

enum EmailProvider {
  RESEND
  SMTP
  SENDGRID
}

model EmailConfig {
  id             String        @id @default(cuid())
  organizationId String        @unique
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       EmailProvider @default(RESEND)
  apiKey         String?
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  fromName       String        @default("Billing")
  fromEmail      String        @default("billing@example.com")
  isVerified     Boolean       @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ------------------------------------------------------
// WhatsApp Configuration
// ------------------------------------------------------

enum WhatsAppProvider {
  TWILIO
  WATI
  META_CLOUD
}

model WhatsAppConfig {
  id             String           @id @default(cuid())
  organizationId String           @unique
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider       WhatsAppProvider @default(TWILIO)
  apiKey         String
  apiSecret      String?
  phoneNumberId  String?
  businessNumber String
  isActive       Boolean          @default(true)
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

// ------------------------------------------------------
// Audit Log
// ------------------------------------------------------

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  userId         String?
  entity         String
  entityId       String
  action         String
  meta           Json?
  
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityId])
}

// ------------------------------------------------------
// Recurring Invoices
// ------------------------------------------------------

enum RecurringInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model RecurringInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  title          String?
  interval       RecurringInterval
  nextIssueDate  DateTime
  endDate        DateTime?
  active         Boolean      @default(true)
  
  subTotal       Float
  cgstTotal      Float        @default(0)
  sgstTotal      Float        @default(0)
  igstTotal      Float        @default(0)
  total          Float
  
  notes          String?
  items          RecurringInvoiceItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model RecurringInvoiceItem {
  id                 String           @id @default(cuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  
  description String
  hsnCode     String?
  quantity    Float
  unitPrice   Float
  unit        String?
  
  taxRate     Float    @default(0)
  cgstAmount  Float    @default(0)
  sgstAmount  Float    @default(0)
  igstAmount  Float    @default(0)
  total       Float
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// CRM Foundation (Future Module — DB-ready now)
// ------------------------------------------------------

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  name           String
  email          String?
  phone          String?
  role           String?
  notes          String?
  lastContactedAt DateTime?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  title          String
  value          Float?
  currency       String       @default("INR")
  stage          String       @default("Lead")
  expectedCloseAt DateTime?
  closedAt       DateTime?
  notes          String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, stage])
}