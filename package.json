{
  "name": "invoice",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate -w @repo/db",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:seed": "npm run db:seed -w @repo/db",
    "process-recurring": "npm run process-recurring -w web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "loadtest:bootstrap": "tsx loadtests/scripts/bootstrap-users.ts",
    "loadtest:dry-run": "tsx loadtests/scripts/bootstrap-users.ts --count 10",
    "loadtest:verify": "tsx loadtests/scripts/verify-sessions.ts",
    "loadtest:smoke": "node loadtests/scripts/run-k6.mjs smoke",
    "loadtest:run": "node loadtests/scripts/run-k6.mjs load",
    "loadtest:stepup": "node loadtests/scripts/run-k6.mjs stepup",
    "loadtest:chaos": "node loadtests/scripts/run-k6.mjs chaos",
    "loadtest:expensive": "node loadtests/scripts/run-k6.mjs expensive",
    "loadtest:gce": "powershell -NoProfile -ExecutionPolicy Bypass -File loadtests/scripts/gce-loadgen.ps1",
    "loadtest:gce:up": "npm run loadtest:gce -- -Action up",
    "loadtest:gce:run": "npm run loadtest:gce -- -Action run",
    "loadtest:gce:results": "npm run loadtest:gce -- -Action results",
    "loadtest:gce:status": "npm run loadtest:gce -- -Action status",
    "loadtest:gce:down": "npm run loadtest:gce -- -Action down",
    "loadtest:gce:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File loadtests/scripts/setup-gcp-chaos-schedule.ps1",
    "loadtest:gce:schedule:cloud": "powershell -NoProfile -ExecutionPolicy Bypass -File loadtests/scripts/setup-gcp-chaos-schedule.ps1 -UseCloudScheduler",
    "loadtest:cloud:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File loadtests/scripts/setup-cloud-run-loadtest.ps1",
    "loadtest:cloud:deploy:skip-build": "powershell -NoProfile -ExecutionPolicy Bypass -File loadtests/scripts/setup-cloud-run-loadtest.ps1 -SkipBuild",
    "loadtest:cloud:upload-users": "powershell -NoProfile -ExecutionPolicy Bypass -File loadtests/scripts/upload-users-gcs.ps1",
    "db:seed-fake-users": "npm run db:seed-fake-users -w @repo/db --"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "tsx": "^4.19.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "react-datepicker": "^9.1.0"
  }
}
