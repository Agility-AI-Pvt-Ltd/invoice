# Copy to repo root on EC2: cp deploy/env.production.example .env

# ECR image (must match tag pushed from CI or deploy/push-ecr.sh)
ECR_IMAGE=429965275836.dkr.ecr.ap-south-1.amazonaws.com/invoicely-prod:latest

# Public URL (must match value used when the image was built)
NEXT_PUBLIC_APP_URL=https://invoice.yourdomain.com

# Neon PostgreSQL connection string.
#
# Vercel (serverless): use the POOLED URL (hostname contains "-pooler")
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# EC2/Docker: prefer the DIRECT URL (no "-pooler" in hostname) for multi-step writes
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

CRON_SECRET=
MCP_BACKEND_SECRET=

# Optional — rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
