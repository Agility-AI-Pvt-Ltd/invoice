# Copy to repo root on EC2: cp deploy/env.production.example .env

# ECR image (must match tag pushed from CI or deploy/push-ecr.sh)
ECR_IMAGE=429965275836.dkr.ecr.ap-south-1.amazonaws.com/invoicely-prod:latest

# Public URL (must match value used when the image was built)
NEXT_PUBLIC_APP_URL=https://invoice.yourdomain.com

# Neon connection for the running app.
# On EC2/Docker with Prisma + pg adapter, prefer the DIRECT (non-pooler) URL —
# PgBouncer transaction pooler breaks multi-step writes (onboarding, etc.).
# Direct:  ep-xxx.ap-southeast-1.aws.neon.tech  (no "-pooler" in hostname)
# Pooled:  ep-xxx-pooler.ap-southeast-1.aws.neon.tech  (use only if you know pooler works)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

CRON_SECRET=
MCP_BACKEND_SECRET=

# Optional — rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
